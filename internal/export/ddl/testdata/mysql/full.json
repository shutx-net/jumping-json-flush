{
  "$schema": "https://raw.githubusercontent.com/shutx-net/jumping-json-flush/main/schema/db-design.schema.json",
  "formatVersion": "1.0",
  "database": {
    "name": "logistics",
    "logicalName": "物流",
    "dbms": "MySQL"
  },
  "tables": [
    {
      "name": "regions",
      "logicalName": "地域",
      "description": "A composite primary key, and a non-unique index no foreign key targets.",
      "columns": [
        {
          "name": "country_code",
          "logicalName": "国コード",
          "type": "CHAR",
          "length": 2,
          "nullable": false
        },
        {
          "name": "region_code",
          "logicalName": "地域コード",
          "type": "VARCHAR",
          "length": 16,
          "nullable": false
        },
        {
          "name": "name",
          "logicalName": "名称",
          "type": "VARCHAR",
          "length": 128,
          "nullable": false
        }
      ],
      "primaryKey": {
        "name": "pk_regions",
        "columns": ["country_code", "region_code"]
      },
      "indexes": [
        {
          "name": "ix_regions_name",
          "columns": ["name"]
        }
      ]
    },
    {
      "name": "warehouses",
      "logicalName": "倉庫",
      "description": "An unnamed primary key led by the AUTO_INCREMENT column, an unnamed unique key and an unnamed foreign key in one table.",
      "columns": [
        {
          "name": "id",
          "logicalName": "倉庫ID",
          "type": "BIGINT",
          "nullable": false,
          "autoIncrement": true
        },
        {
          "name": "region_code",
          "logicalName": "地域コード",
          "type": "VARCHAR",
          "length": 16,
          "nullable": false
        },
        {
          "name": "country_code",
          "logicalName": "国コード",
          "type": "CHAR",
          "length": 2,
          "nullable": false
        },
        {
          "name": "code",
          "logicalName": "倉庫コード",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        },
        {
          "name": "slot",
          "logicalName": "スロット",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        },
        {
          "name": "parent_id",
          "logicalName": "親倉庫ID",
          "type": "BIGINT",
          "nullable": true,
          "description": "A description as well as a logical name, so the comment carries both lines."
        }
      ],
      "primaryKey": {
        "columns": ["id"]
      },
      "uniqueKeys": [
        {
          "columns": ["code"]
        }
      ],
      "foreignKeys": [
        {
          "columns": ["country_code", "region_code"],
          "references": {
            "table": "regions",
            "columns": ["country_code", "region_code"]
          },
          "onDelete": "RESTRICT"
        },
        {
          "name": "fk_warehouses_parent",
          "columns": ["parent_id"],
          "references": {
            "table": "warehouses",
            "columns": ["id"]
          },
          "onUpdate": "CASCADE",
          "onDelete": "SET NULL"
        }
      ],
      "indexes": [
        {
          "name": "ix_warehouses_slot",
          "columns": ["slot"],
          "unique": true
        }
      ]
    },
    {
      "name": "shipments",
      "logicalName": "出荷",
      "description": "No primary key at all, and two unnamed foreign keys that do not collide. The second targets a unique index rather than a unique key, which is why the index phase has to come first.",
      "columns": [
        {
          "name": "warehouse_code",
          "logicalName": "倉庫コード",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        },
        {
          "name": "slot_key",
          "logicalName": "スロットキー",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        }
      ],
      "foreignKeys": [
        {
          "columns": ["warehouse_code"],
          "references": {
            "table": "warehouses",
            "columns": ["code"]
          },
          "onUpdate": "NO ACTION"
        },
        {
          "columns": ["slot_key"],
          "references": {
            "table": "warehouses",
            "columns": ["slot"]
          }
        }
      ]
    },
    {
      "name": "settings",
      "logicalName": "設定",
      "description": "Every shape of default MySQL takes: a number, a decimal, CURRENT_TIMESTAMP, an explicit NULL, a string literal, the empty string, an apostrophe inside a literal, and the parenthesised expressions MySQL 8.0.13 and later require for anything else.",
      "columns": [
        {
          "name": "id",
          "logicalName": "設定ID",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "retry_count",
          "logicalName": "再試行回数",
          "type": "INT",
          "nullable": false,
          "default": "0"
        },
        {
          "name": "rate",
          "logicalName": "レート",
          "type": "DECIMAL",
          "precision": 10,
          "scale": 2,
          "nullable": false,
          "default": "0.00"
        },
        {
          "name": "created_at",
          "logicalName": "作成日時",
          "type": "DATETIME",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        },
        {
          "name": "closed_at",
          "logicalName": "終了日時",
          "type": "DATETIME",
          "nullable": true,
          "default": "NULL"
        },
        {
          "name": "enabled",
          "logicalName": "有効",
          "type": "TINYINT",
          "length": 1,
          "nullable": false,
          "default": "1"
        },
        {
          "name": "token",
          "logicalName": "トークン",
          "type": "CHAR",
          "length": 36,
          "nullable": false,
          "default": "(UUID())"
        },
        {
          "name": "state",
          "logicalName": "状態",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false,
          "default": "'pending'"
        },
        {
          "name": "note",
          "logicalName": "備考",
          "type": "VARCHAR",
          "length": 255,
          "nullable": false,
          "default": "''"
        },
        {
          "name": "owner",
          "logicalName": "所有者",
          "type": "VARCHAR",
          "length": 64,
          "nullable": false,
          "default": "'it''s'"
        },
        {
          "name": "slots",
          "logicalName": "スロット数",
          "type": "INT",
          "nullable": false,
          "default": "(1 + 2)"
        },
        {
          "name": "payload",
          "logicalName": "ペイロード",
          "type": "JSON",
          "nullable": true
        }
      ],
      "primaryKey": {
        "name": "pk_settings",
        "columns": ["id"]
      }
    }
  ]
}
