{
  "$schema": "https://raw.githubusercontent.com/shutx-net/jumping-json-flush/main/schema/db-design.schema.json",
  "formatVersion": "1.0",
  "database": {
    "name": "logistics",
    "logicalName": "物流",
    "dbms": "PostgreSQL"
  },
  "tables": [
    {
      "name": "regions",
      "logicalName": "地域",
      "description": "A composite primary key, and a non-unique index no foreign key targets.",
      "columns": [
        {
          "name": "country_code",
          "logicalName": "国コード",
          "type": "CHAR",
          "length": 2,
          "nullable": false
        },
        {
          "name": "region_code",
          "logicalName": "地域コード",
          "type": "VARCHAR",
          "length": 16,
          "nullable": false
        },
        {
          "name": "name",
          "logicalName": "名称",
          "type": "VARCHAR",
          "length": 128,
          "nullable": false
        }
      ],
      "primaryKey": {
        "name": "pk_regions",
        "columns": [
          "country_code",
          "region_code"
        ]
      },
      "indexes": [
        {
          "name": "ix_regions_name",
          "columns": [
            "name"
          ]
        }
      ]
    },
    {
      "name": "warehouses",
      "logicalName": "倉庫",
      "description": "An unnamed primary key, an unnamed unique key and an unnamed foreign key in one table.",
      "columns": [
        {
          "name": "id",
          "logicalName": "倉庫ID",
          "type": "BIGINT",
          "nullable": false,
          "autoIncrement": true
        },
        {
          "name": "region_code",
          "logicalName": "地域コード",
          "type": "VARCHAR",
          "length": 16,
          "nullable": false
        },
        {
          "name": "country_code",
          "logicalName": "国コード",
          "type": "CHAR",
          "length": 2,
          "nullable": false
        },
        {
          "name": "code",
          "logicalName": "倉庫コード",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        },
        {
          "name": "slot",
          "logicalName": "スロット",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        },
        {
          "name": "parent_id",
          "logicalName": "親倉庫ID",
          "type": "BIGINT",
          "nullable": true,
          "description": "A description as well as a logical name, so the comment carries both lines."
        }
      ],
      "primaryKey": {
        "columns": [
          "id"
        ]
      },
      "uniqueKeys": [
        {
          "columns": [
            "code"
          ]
        }
      ],
      "foreignKeys": [
        {
          "columns": [
            "region_code",
            "country_code"
          ],
          "references": {
            "table": "regions",
            "columns": [
              "region_code",
              "country_code"
            ]
          },
          "onDelete": "RESTRICT"
        },
        {
          "name": "fk_warehouses_parent",
          "columns": [
            "parent_id"
          ],
          "references": {
            "table": "warehouses",
            "columns": [
              "id"
            ]
          },
          "onUpdate": "CASCADE",
          "onDelete": "SET NULL"
        }
      ],
      "indexes": [
        {
          "name": "ix_warehouses_slot",
          "columns": [
            "slot"
          ],
          "unique": true
        }
      ]
    },
    {
      "name": "shipments",
      "logicalName": "出荷",
      "description": "No primary key at all, and two unnamed foreign keys that do not collide.",
      "columns": [
        {
          "name": "warehouse_code",
          "logicalName": "倉庫コード",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        },
        {
          "name": "slot_key",
          "logicalName": "スロットキー",
          "type": "VARCHAR",
          "length": 32,
          "nullable": false
        }
      ],
      "foreignKeys": [
        {
          "columns": [
            "warehouse_code"
          ],
          "references": {
            "table": "warehouses",
            "columns": [
              "code"
            ]
          }
        },
        {
          "columns": [
            "slot_key"
          ],
          "references": {
            "table": "warehouses",
            "columns": [
              "slot"
            ]
          }
        }
      ]
    },
    {
      "name": "settings",
      "logicalName": "設定",
      "description": "Every shape of default that must not produce a finding: literals, an empty SQL string, casts, a qualified type, a function call, an array constructor and a typed literal.",
      "columns": [
        {
          "name": "id",
          "logicalName": "設定ID",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "retry_count",
          "logicalName": "再試行回数",
          "type": "INTEGER",
          "nullable": false,
          "default": "0"
        },
        {
          "name": "rate",
          "logicalName": "レート",
          "type": "NUMERIC",
          "nullable": false,
          "default": "0.00"
        },
        {
          "name": "threshold",
          "logicalName": "しきい値",
          "type": "NUMERIC",
          "nullable": false,
          "default": "1e3"
        },
        {
          "name": "created_at",
          "logicalName": "作成日時",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        },
        {
          "name": "closed_at",
          "logicalName": "終了日時",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "NULL"
        },
        {
          "name": "enabled",
          "logicalName": "有効",
          "type": "BOOLEAN",
          "nullable": false,
          "default": "true"
        },
        {
          "name": "updated_at",
          "logicalName": "更新日時",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "token",
          "logicalName": "トークン",
          "type": "UUID",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        {
          "name": "state",
          "logicalName": "状態",
          "type": "TEXT",
          "nullable": false,
          "default": "'pending'"
        },
        {
          "name": "note",
          "logicalName": "備考",
          "type": "TEXT",
          "nullable": false,
          "default": "''"
        },
        {
          "name": "label",
          "logicalName": "ラベル",
          "type": "TEXT",
          "nullable": false,
          "default": "''::text"
        },
        {
          "name": "owner",
          "logicalName": "所有者",
          "type": "TEXT",
          "nullable": false,
          "default": "'it''s'::text"
        },
        {
          "name": "greeting",
          "logicalName": "あいさつ",
          "type": "TEXT",
          "nullable": false,
          "default": "'hello  world'::text"
        },
        {
          "name": "payload",
          "logicalName": "ペイロード",
          "type": "JSONB",
          "nullable": false,
          "default": "'{}'::jsonb"
        },
        {
          "name": "status",
          "logicalName": "受注状態",
          "type": "TEXT",
          "nullable": false,
          "default": "'pending'::text"
        },
        {
          "name": "slots",
          "logicalName": "スロット数",
          "type": "INTEGER",
          "nullable": false,
          "default": "(1 + 2)"
        },
        {
          "name": "tags",
          "logicalName": "タグ",
          "type": "TEXT ARRAY",
          "nullable": false,
          "default": "ARRAY[]::text[]"
        },
        {
          "name": "escaped",
          "logicalName": "エスケープ",
          "type": "TEXT",
          "nullable": false,
          "default": "E'a\\b'"
        },
        {
          "name": "grace",
          "logicalName": "猶予",
          "type": "INTERVAL",
          "nullable": false,
          "default": "INTERVAL '1 day'"
        }
      ],
      "primaryKey": {
        "name": "pk_settings",
        "columns": [
          "id"
        ]
      }
    }
  ]
}
