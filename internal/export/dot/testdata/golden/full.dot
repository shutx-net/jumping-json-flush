// Generated by jjf from a database design document.
// The JSON is the source of truth: edit it and export again, never this file.
digraph "shop" {
	graph [charset="UTF-8", rankdir=LR];
	node [shape=plaintext];
	edge [dir=both];

	"customers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>顧客</B><BR/>customers</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">顧客ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">メールアドレス</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">credit_limit</TD><TD ALIGN="LEFT">与信限度額</TD><TD ALIGN="LEFT">NUMERIC(12,2)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">作成日時</TD><TD ALIGN="LEFT">TIMESTAMP WITH TIME ZONE</TD></TR>
	</TABLE>>];
	"customer_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>顧客プロフィール</B><BR/>customer_profiles</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">プロフィールID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">顧客ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">nickname</TD><TD ALIGN="LEFT">ニックネーム</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
	</TABLE>>];
	"orders" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>受注</B><BR/>orders</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">受注ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">顧客ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">coupon_id</TD><TD ALIGN="LEFT">クーポンID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">受注金額合計</TD><TD ALIGN="LEFT">NUMERIC(14,2)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">ordered_at</TD><TD ALIGN="LEFT">受注日時</TD><TD ALIGN="LEFT">TIMESTAMP WITH TIME ZONE</TD></TR>
	</TABLE>>];
	"order_lines" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>受注明細</B><BR/>order_lines</TD></TR>
		<TR><TD>PK,FK</TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">受注ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">line_no</TD><TD ALIGN="LEFT">明細番号</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">product_code</TD><TD ALIGN="LEFT">商品コード</TD><TD ALIGN="LEFT">CHAR(13)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT">単価</TD><TD ALIGN="LEFT">NUMERIC(10,2)</TD></TR>
	</TABLE>>];
	"coupons" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>クーポン</B><BR/>coupons</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">クーポンID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">クーポンコード</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">discount_rate</TD><TD ALIGN="LEFT">割引率</TD><TD ALIGN="LEFT">NUMERIC(5,3)</TD></TR>
	</TABLE>>];

	"customer_profiles" -> "customers" [arrowtail=teetee, arrowhead=teetee, label="fk_customer_profiles_customer"];
	"orders" -> "customers" [arrowtail=crowtee, arrowhead=teetee, label="fk_orders_customer"];
	"orders" -> "coupons" [arrowtail=crowodot, arrowhead=teetee, label="fk_orders_coupon"];
	"order_lines" -> "orders" [arrowtail=crowtee, arrowhead=teetee, label="fk_order_lines_order"];
}
