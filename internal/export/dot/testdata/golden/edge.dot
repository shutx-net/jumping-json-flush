// Generated by jjf from a database design document.
// The JSON is the source of truth: edit it and export again, never this file.
digraph "graph" {
	graph [charset="UTF-8", rankdir=LR];
	node [shape=plaintext];
	edge [dir=both];

	"graph" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>グラフ &amp; &lt;図&gt; &quot;面&quot;</B><BR/>graph</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">グラフID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">weight</TD><TD ALIGN="LEFT">重み</TD><TD ALIGN="LEFT">NUMERIC(8)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">ratio</TD><TD ALIGN="LEFT">比率</TD><TD ALIGN="LEFT">NUMERIC(5,2)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">金額 &lt;税込&gt;</TD><TD ALIGN="LEFT">NUMERIC(10)</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">drawn_at</TD><TD ALIGN="LEFT">描画日時</TD><TD ALIGN="LEFT">TIMESTAMP WITH TIME ZONE</TD></TR>
	</TABLE>>];
	"edge" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>辺</B><BR/>edge</TD></TR>
		<TR><TD>PK,FK</TD><TD ALIGN="LEFT">graph_id</TD><TD ALIGN="LEFT">グラフID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">seq</TD><TD ALIGN="LEFT">連番</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">from_node</TD><TD ALIGN="LEFT">始点ノード</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">to_node</TD><TD ALIGN="LEFT">終点ノード</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
	</TABLE>>];
	"edge_labels" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>辺ラベル</B><BR/>edge_labels</TD></TR>
		<TR><TD>PK,FK</TD><TD ALIGN="LEFT">graph_id</TD><TD ALIGN="LEFT">グラフID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>PK,FK</TD><TD ALIGN="LEFT">seq</TD><TD ALIGN="LEFT">連番</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">caption</TD><TD ALIGN="LEFT">表示文字列</TD><TD ALIGN="LEFT">TEXT</TD></TR>
	</TABLE>>];
	"categories" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>分類</B><BR/>categories</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">分類ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">親分類ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">分類名</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR>
	</TABLE>>];
	"node_stats" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
		<TR><TD COLSPAN="4" BGCOLOR="#e8e8e8"><B>ノード統計</B><BR/>node_stats</TD></TR>
		<TR><TD>PK</TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">統計ID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD>FK</TD><TD ALIGN="LEFT">node_id</TD><TD ALIGN="LEFT">ノードID</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
		<TR><TD></TD><TD ALIGN="LEFT">visits</TD><TD ALIGN="LEFT">訪問回数</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
	</TABLE>>];

	// referenced by a foreign key but not defined in this document
	"nodes" [shape=box, style=dashed, color="#999999", fontcolor="#999999", label="nodes\n(not defined in this document)"];

	"edge" -> "graph" [arrowtail=crowodot, arrowhead=teetee, label="fk_edge_graph"];
	"edge" -> "nodes" [arrowtail=crowodot, arrowhead=teeodot, label="from_node"];
	"edge" -> "nodes" [arrowtail=crowodot, arrowhead=teetee, label="fk_edge_to_node"];
	"edge_labels" -> "edge" [arrowtail=teeodot, arrowhead=teetee, label="fk_edge_labels_edge"];
	"categories" -> "categories" [arrowtail=crowodot, arrowhead=teeodot, label="fk_categories_parent"];
	"node_stats" -> "nodes" [arrowtail=teeodot, arrowhead=teetee, label="fk_node_stats_node"];
	"node_stats" -> "graph" [arrowtail=crowodot, arrowhead=teetee, label="fk_node_stats_unknown_column"];
}
