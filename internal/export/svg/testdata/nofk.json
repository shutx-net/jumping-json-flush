{
  "$schema": "https://raw.githubusercontent.com/shutx-net/jumping-json-flush/main/schema/db-design.schema.json",
  "formatVersion": "1.0",
  "database": {
    "name": "catalog",
    "logicalName": "カタログ",
    "description": "外部キーを持たない文書。図は節だけになる。"
  },
  "tables": [
    {
      "name": "products",
      "logicalName": "商品",
      "columns": [
        {
          "name": "code",
          "logicalName": "商品コード",
          "type": "CHAR",
          "length": 13,
          "nullable": false
        },
        {
          "name": "name",
          "logicalName": "商品名",
          "type": "VARCHAR",
          "length": 120,
          "nullable": false
        }
      ],
      "primaryKey": {
        "name": "pk_products",
        "columns": ["code"]
      }
    },
    {
      "name": "warehouses",
      "logicalName": "倉庫",
      "columns": [
        {
          "name": "id",
          "logicalName": "倉庫ID",
          "type": "INTEGER",
          "nullable": false
        },
        {
          "name": "name",
          "logicalName": "倉庫名",
          "type": "VARCHAR",
          "length": 60,
          "nullable": false
        }
      ],
      "primaryKey": {
        "name": "pk_warehouses",
        "columns": ["id"]
      }
    }
  ]
}
