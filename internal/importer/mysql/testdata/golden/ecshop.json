      "primaryKey": {
        "columns": [
          "id"
        ]
      },
      "foreignKeys": [
        {
          "name": "ct_orders_customer",
          "columns": [
            "customer_id"
          ],
          "references": {
            "table": "customers",
            "columns": [
              "id"
            ]
          },
          "onUpdate": "CASCADE",
          "onDelete": "RESTRICT"
