        {
          "name": "ct_order_lines_product",
          "columns": [
            "product_id"
          ],
          "references": {
            "table": "products",
            "columns": [
              "id"
            ]
          }
        }
      ],
      "indexes": [
        {
          "name": "ix_order_lines_product",
          "columns": [
            "product_id"
          ]
        }
      ]
    },
