{
  "$schema": "https://raw.githubusercontent.com/shutx-net/jumping-json-flush/main/schema/db-design.schema.json",
  "formatVersion": "1.0",
  "database": {
    "name": "ecshop",
    "dbms": "MySQL"
  },
  "tables": [
    {
      "name": "customers",
      "logicalName": "顧客",
      "description": "オンラインショップの利用者。退会しても行は残す。",
      "columns": [
        {
          "name": "id",
          "logicalName": "id",
          "type": "BIGINT UNSIGNED",
          "nullable": false,
          "autoIncrement": true
        },
        {
          "name": "email",
          "logicalName": "メールアドレス",
          "type": "VARCHAR",
          "length": 255,
          "nullable": false
        },
        {
          "name": "display_name",
          "logicalName": "display_name",
          "type": "VARCHAR",
          "length": 120,
          "nullable": false
        },
        {
          "name": "note",
          "logicalName": "note",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "referrer_id",
          "logicalName": "referrer_id",
          "type": "BIGINT UNSIGNED",
          "nullable": true
        },
        {
          "name": "profile",
          "logicalName": "profile",
          "type": "JSON",
          "nullable": true
        },
        {
          "name": "active",
          "logicalName": "active",
          "type": "TINYINT",
          "length": 1,
          "nullable": false,
          "default": "'1'"
        },
        {
          "name": "born_on",
          "logicalName": "born_on",
          "type": "DATE",
          "nullable": true
        },
        {
          "name": "balance",
          "logicalName": "残高",
          "type": "DECIMAL",
          "precision": 10,
          "scale": 2,
          "nullable": false,
          "default": "'0.00'"
        },
        {
          "name": "registered_at",
          "logicalName": "registered_at",
          "type": "DATETIME",
          "precision": 3,
          "nullable": false
        },
        {
          "name": "updated_at",
          "logicalName": "updated_at",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      ],
      "primaryKey": {
        "columns": [
          "id"
        ]
      },
      "uniqueKeys": [
        {
          "name": "uq_customers_email",
          "columns": [
            "email"
          ]
        }
      ],
      "foreignKeys": [
        {
          "name": "ct_customers_referrer",
          "columns": [
            "referrer_id"
          ],
          "references": {
            "table": "customers",
            "columns": [
              "id"
            ]
          },
          "onDelete": "SET NULL"
        }
      ],
      "indexes": [
        {
          "name": "ix_customers_referrer",
          "columns": [
            "referrer_id"
          ]
        }
      ]
    },
    {
