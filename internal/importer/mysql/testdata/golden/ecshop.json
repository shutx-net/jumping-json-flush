      ],
      "indexes": [
        {
          "name": "ix_orders_customer",
          "columns": [
            "customer_id"
          ]
        },
        {
          "name": "ix_orders_status_placed",
          "columns": [
            "status",
            "placed_at"
          ]
        }
      ]
    },
