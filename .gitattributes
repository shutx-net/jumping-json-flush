# Normalize everything to LF; the global core.autocrlf=true would otherwise
# check out extension-less files (.gitignore, LICENSE, go.mod, go.sum) as CRLF.
* text=auto eol=lf

*.json text eol=lf
*.go   text eol=lf
*.md   text eol=lf
# install.sh is piped straight into sh. A CRLF checkout would put a carriage
# return in the shebang and in every command it runs.
*.sh   text eol=lf
*.yml  text eol=lf
# Golden files are compared byte for byte, so they must never be checked out as
# CRLF.
*.xml  text eol=lf
*.txt  text eol=lf
*.xlsx binary
